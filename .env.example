# ── Fill in whichever you have; leave the rest blank. ────────────────────────
# The harness auto-skips any provider whose key is missing, so a partial
# .env is fine — it just means fewer rows in the chart.

# OpenAI  — frontier baseline + gpt-5-nano / gpt-5-mini tier
OPENAI_API_KEY=

# Anthropic — Claude Haiku-class cheap tier (+ Sonnet/Opus as frontier baseline)
ANTHROPIC_API_KEY=

# Google — Gemini Flash / Flash-Lite tier (has a free tier)
GEMINI_API_KEY=

# OpenRouter — one key, access to hosted small OPEN models (Qwen3 etc.)
#              Strongly recommended: this is how we price the Qwen side honestly.
OPENROUTER_API_KEY=

# Together / Fireworks / Groq — optional alternate hosts for open models
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=

# HuggingFace — only needed if a dataset or model turns out to be gated
HF_TOKEN=

# Azure AI Foundry (one key, many deployments)
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.services.ai.azure.com
